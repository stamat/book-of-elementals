{
  "scripts": [{
    "in": "src/iife.js",
    "out": "dist/book-of-elementals.js",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false,
      "format": "iife"
    }
  },
  {
    "in": "src/elementals/*/index.js",
    "out": "dist/elementals/",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false,
      "format": "iife"
    }
  },
  {
    "in": "node_modules/poops-docs-theme/src/docs.ts",
    "out": "_site/js/docs.js",
    "options": {
      "minify": true,
      "justMinified": true,
      "format": "iife"
    }
  }],
  "styles": [{
    "in": "src/styles/index.scss",
    "out": "dist/book-of-elementals.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "src/styles/theme.scss",
    "out": "dist/book-of-elementals-theme.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "src/styles/checkbox.scss",
    "out": "dist/book-of-elementals-checkbox.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "src/elementals/*/index.scss",
    "out": "dist/elementals/",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "src/elementals/*/theme.scss",
    "out": "dist/elementals/{{dir}}-theme.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "docs/docs.scss",
    "out": "_site/css/docs.css",
    "options": {
      "minify": true,
      "justMinified": true
    }
  }],
  "markup": {
    "in": "docs",
    "out": "_site",
    "options": {
      "nav": "nav.json",
      "searchIndex": "search-index.json",
      "llms": {
        "out": "llms.txt",
        "intro": "docs/_llms/llms-intro.md",
        "full": true,
        "fullIntro": "docs/_llms/llms-intro-full.md"
      },
      "robots": "robots.txt",
      "site": {
        "title": "Book of Elementals",
        "brand": "book-of-elementals",
        "brandMark": "📓",
        "description": "Accessible custom elements. Light DOM, no build step required.",
        "lang": "en",
        "url": "https://stamat.github.io/book-of-elementals",
        "repo": "https://github.com/stamat/book-of-elementals",
        "footer": "<a href=\"https://github.com/stamat/book-of-elementals\" target=\"_blank\" rel=\"noopener\">book-of-elementals</a> v0.5.1 — MIT licensed. Built with 💩 <a href=\"https://github.com/stamat/poops\" target=\"_blank\" rel=\"noopener\">Poops</a>, <a href=\"https://github.com/stamat/poops-docs-theme\" target=\"_blank\" rel=\"noopener\">poops-docs-theme</a> and <a href=\"https://github.com/stamat/code-preview-element\" target=\"_blank\" rel=\"noopener\">code-preview-element</a>.",
        "branch": "main",
        "iconLinks": [
          { "title": "npm", "url": "https://www.npmjs.com/package/book-of-elementals", "icon": "npm" }
        ]
      }
    }
  },
  "copy": [
    {
      "in": "dist",
      "out": "_site"
    },
    {
      "in": [
        "node_modules/code-preview-element/dist/code-preview-hljs.min.js",
        "node_modules/code-preview-element/dist/code-preview-options.min.js"
      ],
      "out": "_site/js"
    }
  ],
  "exec": {
    "scripts": [
      "npx cem analyze --globs \"src/elementals/*/index.js\" --outdir dist",
      "node script/manifests.js"
    ],
    "markup": "node script/demos.js"
  },
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "serve": {
    "port": 4040
  },
  "livereload": true,
  "watch": [
    "src",
    "docs",
    "dist"
  ],
  "includePaths": [
    "node_modules"
  ]
}
