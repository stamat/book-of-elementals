    "axe-core": "^4.12.1",
    "code-preview-element": "^3.0.0",
    "es-check": "^9.6.4",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "playwright-core": "^1.62.1",
    "poops": "^2.0.0",
    "poops-docs-theme": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
